<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # El destino editable de /1 se guarda en Firestore desde el panel /1/admin.
  RewriteRule ^1/?$ https://us-central1-cdeluar-ddefc.cloudfunctions.net/redirectShortLinkOne [R=302,L,NE,E=NO_CACHE_SHORT_REDIRECT:1]
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^ps4/?$ https://www.superpsx.com/category/ps4/ps4-games-free/ [R=302,L]
  # Los scrapers sociales no ejecutan Vue: entregales metadatos del contenido.
  RewriteCond %{REQUEST_METHOD} ^GET$
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|facebookcatalog|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest) [NC]
  RewriteRule ^(noticia|s|c)/[^/]+(?:/[^/]*)?$ share-preview.php [L,QSA]
  # Un chunk inexistente debe devolver 404; entregar index.html con URL .js
  # provoca errores de importación y puede cachear HTML como si fuera JavaScript.
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [E=NO_CACHE_MISSING_ASSET:1,R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Seguridad y consistencia basica.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cache-Control "no-store" env=NO_CACHE_SHORT_REDIRECT

  # HTML debe revalidarse para evitar servir shell viejo.
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Service worker debe refrescarse rapido.
  <Files "firebase-messaging-sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  # Assets versionados (Vite hash) cache largo + immutable.
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # No conservar respuestas de error (incluidos chunks que ya no existen).
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NO_CACHE_MISSING_ASSET
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript text/javascript application/json application/manifest+json application/ld+json image/svg+xml
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding
  </IfModule>
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript text/javascript application/json application/manifest+json application/ld+json image/svg+xml
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding
  </IfModule>
</IfModule>
